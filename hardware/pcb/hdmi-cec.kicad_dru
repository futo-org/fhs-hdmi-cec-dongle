(version 1)

# J1 is a card-edge HDMI plug, so its pads run to the board edge by design
(rule "J1 edge pads"
	(constraint edge_clearance)
	(condition "A.memberOfFootprint('J1') || B.memberOfFootprint('J1')")
	(severity ignore))

# TMDS runs GSG: each P/N trace has a GND trace between them, following the HDMI pinout.
# 0.31mm width gives ~100 ohm differential on this stackup (99 ohm with the GND trace between P/N, 102 ohm without).
# Tracks neck to 0.28mm where they pass the via row at the card edge plug.

(rule "TMDS track width"
	(condition "A.NetClass == 'TMDS'")
	(layer outer)
	(constraint track_width (min 0.28mm) (opt 0.31mm) (max 0.32mm)))

(rule "TMDS no inner layers"
	(condition "A.NetClass == 'TMDS' && A.Type == 'Track'")
	(layer inner)
	(constraint disallow track))

(rule "TMDS pair gap"
	(condition "A.inDiffPair('*TMDS_*')")
	(constraint diff_pair_gap (min 0.67mm) (opt 0.69mm) (max 0.72mm)))

(rule "TMDS intra-pair skew"
	(condition "A.inDiffPair('*TMDS_*')")
	(constraint skew (max 0.1mm) (within_diff_pairs)))

(rule "TMDS inter-pair skew"
	(condition "A.NetClass == 'TMDS'")
	(constraint skew (max 2.5mm)))

(rule "TMDS via count"
	(condition "A.NetClass == 'TMDS'")
	(constraint via_count (max 2)))

(rule "TMDS coplanar GND gap"
	(condition "A.NetClass == 'TMDS' && A.Type == 'Track' && B.NetName == 'GND' && (B.Type == 'Track' || B.Type == 'Zone')")
	(constraint clearance (min 0.24mm)))

(rule "TMDS isolation from signals"
	(condition "A.NetClass == 'TMDS' && B.NetClass != 'TMDS' && B.NetName != 'GND' && A.Type != 'Pad' && B.Type != 'Pad'")
	(constraint clearance (min 0.5mm)))

# CEC is next to CLK- in the HDMI pinout and has no room to move away
(rule "TMDS CEC neighbor"
	(condition "A.NetClass == 'TMDS' && B.NetName == 'CEC' && A.Type != 'Pad' && B.Type != 'Pad'")
	(constraint clearance (min 0.13mm)))

(rule "JLC via hole to track"
	(condition "A.Type == 'Via' && B.Type == 'Track'")
	(constraint hole_clearance (min 0.2mm)))
