// Applied on top of panel.json in place of the JLC V-cut preset.
{
    "layout": {
        // Keeps the 70mm panel height JLC needs for double-sided assembly. The female HDMI overhangs the 3mm gap on each side of the backbone by 2.31mm.
        "vspace": "3mm",
        "hbackbone": "30mm",
        "hbonecut": false
    },
    "tabs": {
        // Only the side edges get tabs. Copper on the female HDMI edge is too close for mousebite holes.
        "type": "fixed",
        "hcount": 2,
        "vcount": 0,
        "hwidth": "5mm"
    },
    "cuts": {
        "type": "mousebites",
        "drill": "0.6mm",
        "spacing": "0.9mm",
        // Holes sit just outside the edge because U3 and the USB-C shell legs are 0.25mm from it. Leaves a nub to sand.
        "offset": "-0.3mm",
        "prolong": "0.5mm"
    },
    "post": {
        "millradius": "1mm"
    }
}
